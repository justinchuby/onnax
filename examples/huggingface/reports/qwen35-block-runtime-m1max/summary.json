  "scope": "Actual exported checkpoint recomputation/VJP with real task activations and loss cotangents; independent guarded worker per case; fixed parameters; 10 warmups and 100 samples; one block only",
  "driver_source": "import json,os,subprocess,sys\nfrom pathlib import Path\nroot=Path('/Users/justinc/Documents/GitHub/onnax')\noutput=root/'examples/huggingface/reports/qwen35-block-runtime-m1max'\ncompleted=[]\nfor length in (64,512):\n for block in ('decoder_0_1','decoder_3_4'):\n  for policy in ('fused','unfused'):\n   name=f'{length}-{block}-{policy}'\n   guard=Path('/tmp')/f'onnax-block-matrix-{name}-guard'\n   command=[sys.executable,'-m','examples.huggingface.block_runtime','measure','--bundle','/tmp/onnax-qwen35-real-sft/export/execution','--captures',f'/tmp/onnax-block-runtime-capture{length}','--block',block,'--provider','mlx','--library','/tmp/onnax-gated-test-runtime/libonnxruntime_mlx_ep.dylib','--warmup','10','--samples','100','--output',str(output/f'runtime-{name}.json')]\n   if policy=='unfused':command+=['--unfused']\n   wrapped=[sys.executable,'-m','examples.huggingface.guard','--output-dir',str(guard),'--',*command]\n   with (Path('/tmp')/f'onnax-block-matrix-{name}.log').open('w') as log:\n    subprocess.run(wrapped,cwd=root,env={**os.environ,'HF_HUB_OFFLINE':'1'},stdout=log,stderr=subprocess.STDOUT,check=True)\n   completed.append(name)\n   Path('/tmp/onnax-block-runtime-matrix-progress.json').write_text(json.dumps({'completed':completed}))\n   print(name,flush=True)\n"
}
